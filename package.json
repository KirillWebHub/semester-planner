{
  "name": "semester-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "start:api": "node server/publicApi.js",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src server api tests vite.config.js vercel.json amvera.yaml .github/workflows/*.yml",
    "format:check": "prettier --check src server api tests vite.config.js vercel.json amvera.yaml .github/workflows/*.yml"
  },
  "dependencies": {
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  }
}
